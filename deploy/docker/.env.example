# CoolShark Docker 环境变量
# 复制此文件为 .env 并填写实际值（.env 已被 .gitignore，绝不提交仓库）

# ============================================================
# 🔴 第一批安全加固（2026-09 起生效）——生产 .env 必须全部使用强随机值：
#   生成命令（任选其一，在服务器执行）：
#     openssl rand -base64 32   # MySQL 密码（≥16 位，base64 32 → 44 字符）
#     openssl rand -base64 48   # JWT_SECRET（64 字符 = 64 字节 ≥ HS512 要求）
#     openssl rand -base64 32   # REDIS_PASSWORD
#   严禁使用下方示例/占位值作为生产密钥
# ============================================================

# MySQL（TODO #24：去除弱密码，必须 ≥16 位强随机）
MYSQL_ROOT_PASSWORD=root

# Redis（TODO R1~R4：开启认证后必须与 redis-master.conf 的 requirepass 一致）
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# JWT（TODO #25：生产务必替换为 openssl rand -base64 48 生成的强随机密钥，
#      与代码 yml 默认值相同 = 可伪造任意用户 token，是最严重安全洞）
JWT_SECRET=CooxiaoMall2026JwtSecretKeyForHs512AlgorithmMustBeAtLeast64BytesLong

# DeepSeek AI
AI_API_KEY=sk-placeholder
AI_API_BASE_URL=https://api.deepseek.com

# 硅基流动 Embedding
EMBEDDING_API_KEY=sk-placeholder

# Nacos 认证（TODO #13：开启后所有客户端须配 nacos 账号）
# NACOS_AUTH_TOKEN: Base64 ≥32字节随机串（服务端 JWT 签名密钥）
# NACOS_AUTH_IDENTITY_VALUE: 服务端间身份识别随机值
# NACOS_PASSWORD: 客户端连接用 nacos 用户密码（需先初始化，见 #13 部署清单）
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_VALUE=
NACOS_PASSWORD=

# 资源访问主机（部署后改为实际域名或IP）
RESOURCE_HOST=http://localhost/

# 支付宝（模拟支付模式下不需要）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
