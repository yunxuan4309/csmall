# CoolShark Docker 环境变量
# 复制此文件为 .env 并填写实际值

# MySQL
MYSQL_ROOT_PASSWORD=root

# Redis
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# JWT（生产环境务必替换为强随机密钥）
JWT_SECRET=CooxiaoMall2026JwtSecretKeyForHs512AlgorithmMustBeAtLeast64BytesLong

# DeepSeek AI
AI_API_KEY=sk-placeholder
AI_API_BASE_URL=https://api.deepseek.com

# 硅基流动 Embedding
EMBEDDING_API_KEY=sk-placeholder

# 资源访问主机（部署后改为实际域名或IP）
RESOURCE_HOST=http://localhost/

# 支付宝（模拟支付模式下不需要）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
